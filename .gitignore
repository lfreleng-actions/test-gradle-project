# Gradle build output
build/
.gradle/

# Note the absence of a blanket '*.jar' rule, which the Maven fixture
# carries. Gradle's wrapper JAR is version-controlled by design: the
# build lane runs ./gradlew and validates the JAR's checksum, so ignoring
# it would break the build rather than tidy the tree. Compiled artefacts
# land in build/ and are already covered above.

# Sonar scanner working directory
.scannerwork/
.sonar/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
